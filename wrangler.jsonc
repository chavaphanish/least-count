{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "least-count",
  "main": "server/index.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "ROOMS", "class_name": "GameRoom" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Directory", "GameRoom"] },
  ],
  "vars": {
    "SUPABASE_URL": "https://ugyaoeckoqkhqaqezoqg.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_97YNUcL6PYOVLls_ZQ48fg_G7WRCyIU",
  },
  "workers_dev": true,
  "preview_urls": true,
}
